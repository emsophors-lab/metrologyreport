# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONNECTION (Required for Production Database integration on Vercel / GitHub)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# Enable demo testing credentials for local/previews
VITE_ENABLE_DEMO_LOGIN=true

# Local legacy API auth compatibility only. Keep disabled in production.
ALLOW_LEGACY_API_HEADER_AUTH=false
VITE_ALLOW_LEGACY_API_HEADER_AUTH=false

# FRONTEND TELEGRAM CONFIGURATION
# NOTE: Frontend variables start with VITE_; they are exposed to the client in the browser.
VITE_TELEGRAM_BOT_USERNAME="NMC_License_Reminder_Bot"

# OpenStreetMap Tile Configuration (Leaflet map default integration doesn't require paid API keys)
# For high-volume production, NMC may configure custom self-hosted or dedicated tile servers here if needed.

# SERVER-SIDE ONLY CONFIGURATIONS
# WARNING: Secret variables must never be exposed in frontend code.
# Supabase service role key must never be used in browser/client code.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Telegram bot secrets (used exclusively in backend/serverless functions)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_BOT_USERNAME="NMC_License_Reminder_Bot"

# Optional: separate Telegram bots by purpose
TELEGRAM_REPORT_BOT_TOKEN="your-report-group-bot-token"
TELEGRAM_REPORT_BOT_USERNAME="NMC_Report_Notification_Bot"
TELEGRAM_REPORT_CHAT_ID="-1001234567890"
TELEGRAM_REMINDER_BOT_TOKEN="your-company-reminder-bot-token"
TELEGRAM_REMINDER_BOT_USERNAME="NMC_License_Reminder_Bot"

# Webhook protection & secure cron trigger signatures
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret-token"
CRON_SECRET="your-weekly-or-daily-cron-secret"

# DATABASE DRIVER
# 'supabase' (default) uses VITE_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above.
# 'mysql' uses MYSQL_URL and src/db/mysqlClient.ts instead. See mysql/README.md.
DB_DRIVER=supabase
MYSQL_URL=mysql://root@127.0.0.1:3306/mlrs

# Annex 8 document storage: 'supabase' (Storage bucket) or 'fs' (a local
# directory, for a server with no object store). See docs/database-portability.md.
ANNEX8_STORAGE_DRIVER=supabase
ANNEX8_STORAGE_DIR=./.storage

# Enable only after applying the additive report_issuances migration.
# Both flags are required; VITE_ changes require a frontend rebuild.
REPORT_QR_ENABLED=false
VITE_REPORT_QR_ENABLED=false
REPORT_VERIFICATION_ORIGIN=https://metrologyreport.vercel.app
# Background ML is opt-in; apply the approved SQL migration and run a persistent worker first.
ML_LIFECYCLE_ENABLED=false
ML_RETRAIN_REPORT_THRESHOLD=25
ML_ANOMALY_SPIKE_RATIO=0.3
ML_DRIFT_MIN_REPORTS=10
ML_RETRAIN_COOLDOWN_MS=21600000
ML_MODEL_DIR=var/ml-models

# --- Smart Analytics: the machine as analyst ---
# The analyst block of the Khmer analytics report is always filled by the
# system, naming the model set that produced the figures. These two settings
# only control who WORDS the commentary.
#
# With ANALYTICS_AI_ENABLED=false (the default) the wording comes from the
# deterministic Khmer drafter and nothing leaves the server. With it true and
# a key set, an AI agent words it from the computed figures instead; it is
# sent aggregate counts, rates and period labels only — never a licensee
# name, licence number or serial — and any sentence containing a figure we
# did not compute is rejected and the deterministic draft used.
#
# Trained-model risk scores and ML anomaly signals in the same report depend
# on ML_LIFECYCLE_ENABLED above, not on these.
# The agent is asked only when an officer presses "Rewrite with the AI
# agent" on the report screen, never on page load: the model takes tens of
# seconds when the provider is busy, and a report nobody can read until it
# answers is worse than one worded by the system.
ANALYTICS_AI_ENABLED=false
# GEMINI_API_KEY=
# A comma-separated list, tried in order. The provider's flash models go
# through spells of "experiencing high demand"; whichever answers is the one
# named in the report's limitations, so a substitution is visible.
# ANALYTICS_AI_MODEL=gemini-3.8-flash,gemini-flash-latest,gemini-3.7-flash
# Total time across every model and retry. Must stay under the serverless
# function's maxDuration (60s in vercel.json) so the report is returned by us
# rather than cut off by the platform.
# ANALYTICS_AI_BUDGET_MS=50000
# ANALYTICS_AI_TIMEOUT_MS=45000
# ANALYTICS_AI_ATTEMPTS=1
# ML_PYTHON=/absolute/path/to/venv/bin/python
