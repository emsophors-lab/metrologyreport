{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist/server.cjs",
    "lint": "tsc --noEmit",
    "auth:check": "tsx scripts/auth-login-check.ts",
    "routing:check": "tsx scripts/vercel-routing-check.ts",
    "annex8:notification-check": "tsx scripts/annex8-submission-notification-check.ts",
    "annex8:digest-check": "tsx scripts/monthly-digest-check.ts",
    "annex8:digest-api-check": "tsx scripts/monthly-digest-api-check.ts",
    "annex8:check": "tsx scripts/annex8-check-template.ts && tsx scripts/annex8-check-db-mapping.ts && tsx scripts/annex8-check-entries.ts",
    "mysql:check": "tsx scripts/mysql-adapter-check.ts",
    "annex8:scenario": "node scripts/annex8-scenario.mjs",
    "annex8:carry-over": "node scripts/annex8-carry-over-check.mjs",
    "annex8:scope": "node scripts/annex8-scope-check.mjs",
    "consolidated:check": "tsx scripts/consolidated-check.ts && tsx scripts/consolidated-sql.ts",
    "consolidated:test": "tsx scripts/consolidated-test.ts && tsx scripts/consolidated-automatic-test.ts && tsx scripts/consolidated-db-test.ts",
    "consolidated:mysql-test": "tsx scripts/consolidated-db-test.ts --mysql",
    "consolidated:api-check": "tsx scripts/consolidated-api-check.ts",
    "consolidated:officer-check": "tsx scripts/consolidated-officer-drafts-check.ts",
    "annex8:review": "node scripts/annex8-staff-review-check.mjs",
    "annex8:check:sql": "node scripts/annex8-check-supabase-sql.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "docxtemplater": "3.47.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "html2canvas": "^1.4.1",
    "jimp": "^1.6.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "khmer-chhankitek-calendar": "^1.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "3.11.5",
    "pizzip": "3.1.7",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/express": "^4.17.21",
    "@types/google.maps": "^3.65.2",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
