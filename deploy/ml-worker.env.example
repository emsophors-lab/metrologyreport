# Install as /etc/mlrs/ml-worker.env with mode 0600, owned by root.
# Credentials belong only in that private host file, never in Git.
DB_DRIVER=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_HOST
ML_LIFECYCLE_ENABLED=true
ML_PYTHON=/opt/mlrs/.venv-ml/bin/python
ML_MODEL_DIR=/var/lib/mlrs-models
ML_RETRAIN_REPORT_THRESHOLD=25
ML_ANOMALY_SPIKE_RATIO=0.3
ML_DRIFT_MIN_REPORTS=10
ML_RETRAIN_COOLDOWN_MS=21600000
